{
  "openapi": "3.0.3",
  "info": {
    "title": "ABB Security Operations Center API",
    "description": "RESTful API contract for ABB Industrial Cybersecurity Monitoring & Incident Response Platform",
    "version": "4.2.0"
  },
  "servers": [
    {
      "url": "https://soc.abb.com/api/v1",
      "description": "Production SOC Cluster"
    }
  ],
  "paths": {
    "/dashboard/metrics": {
      "get": {
        "summary": "Get 24h telemetry overview metrics",
        "responses": {
          "200": {
            "description": "Aggregated metrics for events, high risk, critical incidents, and protected hosts."
          }
        }
      }
    },
    "/incidents": {
      "get": {
        "summary": "List security incidents",
        "parameters": [
          { "name": "severity", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "subnet", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Filtered array of incident records" }
        }
      }
    },
    "/incidents/{id}/actions/{actionId}/execute": {
      "post": {
        "summary": "Execute response action playbook",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "actionId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Action executed and logged to audit trail" }
        }
      }
    },
    "/network/topology": {
      "get": {
        "summary": "Retrieve industrial zone topology",
        "responses": {
          "200": { "description": "Tree structure: Internet -> NGFW -> Router -> Subnets -> Hosts" }
        }
      }
    },
    "/assets": {
      "get": {
        "summary": "Query CMDB asset inventory",
        "responses": {
          "200": { "description": "Array of managed host entities with sensor status" }
        }
      }
    },
    "/vulnerabilities": {
      "get": {
        "summary": "Fetch discovered CVE vulnerability instances",
        "responses": {
          "200": { "description": "List of active vulnerabilities and remediation recommendations" }
        }
      }
    },
    "/reports": {
      "get": {
        "summary": "List formal incident dossiers",
        "responses": {
          "200": { "description": "Compliance report records" }
        }
      }
    }
  }
}
